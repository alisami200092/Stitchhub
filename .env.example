# -----------------------------------------------------------------------------
# StitchHub B2B Command Center - Environment Configurations Example
# -----------------------------------------------------------------------------

# Direct connection string to PostgreSQL (used by Drizzle ORM for migrations/updates)
DATABASE_URL="postgresql://<user>:<password>@<host>:<port>/<dbname>"

# Supabase API URL (Project Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"

# Supabase Anonymous/Publishable Key (Project Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY="<your-supabase-anon-key>"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<your-supabase-publishable-key>"

# Brevo SMTP/Transactional Email API Key (used for sending transactional alerts)
BREVO_API_KEY="xkeysib-..."

# Polar.sh Payment Processing (sandbox environment for development)
# Create an organization access token at https://sandbox.polar.sh/settings
POLAR_ACCESS_TOKEN="polar_at_..."
POLAR_WEBHOOK_SECRET="whsec_..."

# Product ID for the deposit payment product created in Polar.sh sandbox dashboard
POLAR_PRODUCT_ID="<product-id-from-polar-dashboard>"

# Public site URL (used for webhook callbacks and redirects)
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# =============================================================================
# 🌲 1st PRIORITY: Pinecone Vector Database (RAG Specs & Catalog Guardrails)
# =============================================================================
PINECONE_API_KEY="pcsk_..."
PINECONE_INDEX_NAME="stitchhub-catalog"

# =============================================================================
# 🤖 Multi-Tier LLM Agent Configuration (Localhost / Hugging Face / Gemini)
# =============================================================================
# LLM Provider Preference: "auto" (default), "local", "huggingface", "gemini"
# "auto" detects if local Ollama is active; if up, uses Localhost; otherwise switches to Hugging Face Cloud
LLM_PREFERENCE="auto"

# 1. Localhost Ollama Model (Runs on local machine)
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="stitchhub-v5"

# 2. Hugging Face Cloud Space (Hosted Gradio Client)
HF_SPACE_ID="alisami2000/stitchhub"

# 3. Google Gemini Fallback & Vector Embeddings
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-1.5-flash"
