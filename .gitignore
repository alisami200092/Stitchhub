# ─────────────────────────────────────────────────────────────
# Stitch Hub — Master .gitignore
# Comprehensive rules for Next.js 16, TypeScript, Bun/Node,
# Supabase, Drizzle ORM, IDEs, and OS artifacts.
# ─────────────────────────────────────────────────────────────

# --- Dependencies & Package Managers ---
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.bun/
bun.lockb.tmp*

# --- Environment Variables & Secrets (CRITICAL) ---
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.env
!*.env.example

# --- Next.js Build Outputs & Cache ---
.next/
out/
build/
dist/
.turbo/
next-env.d.ts.bak

# --- TypeScript Build Cache ---
*.tsbuildinfo
next-env.d.ts

# --- Testing & Coverage ---
coverage/
.nyc_output/
*.lcov

# --- Logs & Runtime Artifacts ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Local Databases, Dumps & Drizzle Caches ---
*.db
*.db-journal
*.sqlite
*.sqlite3
.drizzle/backup/

# --- Operating System Junk ---
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- IDEs & Code Editors ---
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swp
.zed/
.fleet/

# --- AI Agents & Workspace Tooling ---
.opencode/
.gemini/
.agents/scratch/
.cursor/
*.tmp
*.temp
temp_*
